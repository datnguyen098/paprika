<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config
  Cho phep HTTP cleartext CHI voi cac host noi bo / dev.
  Moi host ngoai danh sach nay van bi chan cleartext, app production van an toan.

  Hosts duoc phep:
    10.0.2.2         : Android Emulator loopback toi may host
    192.168.1.53     : IP LAN may dev (doi IP o day neu may dev doi mang)
    127.0.0.1        : localhost (iOS Simulator)
    localhost         : alias cho 127.0.0.1

  Khi build production, truyen baseUrl bang API_BASE_URL=... (voi HTTPS)
  thi app se goi HTTPS nen khong anh huong gi.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.53</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
